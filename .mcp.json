{
  "mcpServers": {
    "playwright": {
      "type": "stdio",
      "command": "node",
      "args": [
        "node_modules/@playwright/mcp/cli.js",
        "--browser",
        "chrome",
        "--isolated",
        "--storage-state",
        ".auth/user.json",
        "--allowed-origins",
        "https://demo.suiteondemand.com;https://betappabharath-api-testlab.bharathbetappa.workers.dev",
        "--output-dir",
        ".playwright-mcp",
        "--viewport-size",
        "1280x800"
      ]
    }
  }
}
