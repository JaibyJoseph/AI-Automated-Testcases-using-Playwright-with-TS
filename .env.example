# Copy this file to .env and adjust values. Never commit .env.
# Real environment variables (e.g. in CI) override values from .env.

# UI application under test
BASE_URL=https://demo.suiteondemand.com

# Demo login. Use the credentials SuiteCRM publishes for its public demo.
SUITECRM_USERNAME=
SUITECRM_PASSWORD=

# API application under test (banking practice API, Swagger UI at <API_BASE_URL>/swagger)
API_BASE_URL=https://betappabharath-api-testlab.bharathbetappa.workers.dev

# Practice user. Use the credentials shown in the API's Swagger "Authentication" example.
API_USER_EMAIL=
API_USER_PASSWORD=
